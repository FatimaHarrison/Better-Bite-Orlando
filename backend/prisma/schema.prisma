generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model food_locations {
  location_id     Int       @id @default(autoincrement())
  source_provider String    @db.VarChar(50)
  location_type   String    @db.VarChar(50)
  name            String    @db.VarChar(150)
  description     String?   @db.Text
  address         String?   @db.VarChar(255)
  url             String?   @db.VarChar(255)
  organization    String?   @db.VarChar(150)
  hours           String?   @db.Text
  created_at      DateTime? @default(now()) @db.Timestamp(0)
}

model healthy_restaurants {
  restaurant_id     Int       @id @default(autoincrement())
  source_provider   String?   @db.VarChar(50)
  name              String    @db.VarChar(150)
  formatted_address String?   @db.VarChar(255)
  hours             String?   @db.Text
  website           String?   @db.VarChar(255)
  cuisine_type      String?   @db.VarChar(100)
  diet_options      String?   @db.VarChar(255)
  created_at        DateTime? @default(now()) @db.Timestamp(0)
}

model recipes {
  recipe_id           Int       @id @default(autoincrement())
  spoonacular_id      Int?      @unique(map: "spoonacular_id")
  title               String    @db.VarChar(255)
  image_url           String?   @db.VarChar(255)
  ready_in_minutes    Int?
  source_url          String?   @db.VarChar(255)
  health_score        Decimal?  @db.Decimal(5, 2)
  calories            Decimal?  @db.Decimal(8, 2)
  fat_grams           Decimal?  @db.Decimal(8, 2)
  saturated_fat_grams Decimal?  @db.Decimal(8, 2)
  sugar_grams         Decimal?  @db.Decimal(8, 2)
  instructions        String?   @db.Text
  created_at          DateTime? @default(now()) @db.Timestamp(0)
}

model user_favorites {
  favorite_id Int                      @id @default(autoincrement())
  user_id     Int
  item_type   user_favorites_item_type
  item_id     Int
  created_at  DateTime?                @default(now()) @db.Timestamp(0)
  user        User                     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_favorites_ibfk_1")

  @@index([user_id], map: "user_id")
}

model user_preferences {
  preference_id          Int      @id @default(autoincrement())
  user_id                Int
  is_vegetarian          Boolean? @default(false)
  is_vegan               Boolean? @default(false)
  is_gluten_free         Boolean? @default(false)
  is_dairy_free          Boolean? @default(false)
  is_low_sodium          Boolean? @default(false)
  is_high_protein        Boolean? @default(false)
  email_notifications    Boolean? @default(true)
  recipe_recommendations Boolean? @default(true)
  new_resources          Boolean? @default(true)
  marketing_promotions   Boolean? @default(false)
  push_notifications     Boolean? @default(false)
  user                   User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_preferences_ibfk_1")

  @@index([user_id], map: "user_id")
}

model User {
  id             Int    @id @default(autoincrement()) @map("user_id")
  firstName      String @map("first_name") @db.VarChar(50)
  lastName       String @map("last_name") @db.VarChar(50)
  email          String @unique(map: "email") @db.VarChar(100)
  passwordHash   String @map("password_hash") @db.VarChar(255)
  defaultZipCode String @map("default_zip_code") @db.VarChar(10)

  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @default(now()) @map("updated_at") @db.Timestamp(0)

  passwordResetToken   String?   @unique @map("password_reset_token") @db.VarChar(64)
  passwordResetExpires DateTime? @map("password_reset_expires") @db.DateTime(3)

  favorites   user_favorites[]
  preferences user_preferences[]

  @@map("users")
}

enum user_favorites_item_type {
  food_location
  restaurant
  recipe
}
